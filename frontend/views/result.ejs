<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submission Confirmed | DevOps Terraform Assignment 8</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

    <!-- Navigation Header -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="fas fa-cubes text-info me-2"></i>Terraform AWS Infrastructure Suite
            </a>
            <div class="ms-auto">
                <a href="/" class="btn btn-outline-light btn-sm me-2"><i class="fas fa-arrow-left me-1"></i> New Form</a>
                <a href="/submissions" class="btn btn-info btn-sm"><i class="fas fa-database me-1"></i> All Submissions</a>
            </div>
        </div>
    </nav>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                
                <!-- Success Banner -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 text-center overflow-hidden">
                    <div class="bg-success text-white py-4 px-3">
                        <div class="display-5 mb-2"><i class="fas fa-check-circle"></i></div>
                        <h3 class="fw-bold mb-1">Payload Processed by Flask Backend!</h3>
                        <p class="opacity-75 mb-0">Terraform-Provisioned Multi-Tier Infrastructure Verified</p>
                    </div>
                    
                    <div class="card-body p-4 text-start">
                        <div class="alert alert-info border-0 rounded-3 mb-4">
                            <strong><i class="fas fa-info-circle me-1"></i> Response from Flask API:</strong>
                            <p class="mb-0 mt-1 fs-6"><%= result.message %></p>
                        </div>

                        <h5 class="fw-bold text-dark mb-3">Processed Payload Details</h5>
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped rounded-3 overflow-hidden">
                                <tbody>
                                    <tr>
                                        <th class="w-35 text-secondary">Applicant Name:</th>
                                        <td class="fw-bold"><%= result.data.name %></td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Email Address:</th>
                                        <td><%= result.data.email %></td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Track / Course:</th>
                                        <td><%= result.data.course %></td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Priority:</th>
                                        <td><span class="badge bg-warning text-dark"><%= result.data.priority %></span></td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Compute Hostname:</th>
                                        <td><code class="text-primary fw-bold"><%= result.data.container_id %></code></td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Timestamp:</th>
                                        <td><%= result.processed_at %></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a href="/" class="btn btn-secondary px-4 rounded-3"><i class="fas fa-arrow-left me-1"></i> Submit Another</a>
                            <a href="/submissions" class="btn btn-primary px-4 rounded-3"><i class="fas fa-list me-1"></i> View Submissions Table</a>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
