<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submissions | DevOps Terraform Assignment 8</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

    <!-- Navigation Header -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="fas fa-cubes text-info me-2"></i>Terraform AWS Infrastructure Suite
            </a>
            <div class="ms-auto">
                <a href="/" class="btn btn-outline-light btn-sm"><i class="fas fa-edit me-1"></i> Submit New Form</a>
            </div>
        </div>
    </nav>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold text-dark mb-0">Terraform Infrastructure Submissions</h3>
                        <p class="text-muted small mb-0">Live records retrieved dynamically from Flask Backend via <code><%= backendUrl %>/submissions</code></p>
                    </div>
                    <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">Total: <%= total %></span>
                </div>

                <% if (submissions.length === 0) { %>
                    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                        <i class="fas fa-inbox text-muted display-4 mb-3"></i>
                        <h5 class="fw-bold">No submissions stored yet</h5>
                        <p class="text-muted">Submit a request through the registration portal to see it recorded here.</p>
                        <div>
                            <a href="/" class="btn btn-primary rounded-3 px-4"><i class="fas fa-plus me-1"></i> Create First Submission</a>
                        </div>
                    </div>
                <% } else { %>
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>#</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Track</th>
                                        <th>Priority</th>
                                        <th>Host / Container</th>
                                        <th>Timestamp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% submissions.forEach(function(item) { %>
                                        <tr>
                                            <td class="fw-bold">#<%= item.id %></td>
                                            <td><strong><%= item.name %></strong></td>
                                            <td><%= item.email %></td>
                                            <td><%= item.course %></td>
                                            <td>
                                                <span class="badge <%= item.priority === 'High' ? 'bg-danger' : (item.priority === 'Medium' ? 'bg-warning text-dark' : 'bg-secondary') %>">
                                                    <%= item.priority %>
                                                </span>
                                            </td>
                                            <td><code><%= item.container_id %></code></td>
                                            <td class="small text-muted"><%= item.processed_at %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% } %>

                <div class="text-center mt-4">
                    <a href="/" class="btn btn-outline-secondary rounded-3 px-4"><i class="fas fa-arrow-left me-1"></i> Return to Registration Form</a>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
