<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DevOps Terraform Assignment 8 | AWS Infrastructure as Code</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

    <!-- Navigation Header -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="fas fa-cubes text-info me-2"></i>Terraform AWS Infrastructure Suite
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navContent">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="/"><i class="fas fa-edit me-1"></i> Registration Form</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/submissions"><i class="fas fa-database me-1"></i> Submissions</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/health" target="_blank"><i class="fas fa-heartbeat me-1"></i> Healthcheck</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                
                <!-- Architecture Info Card -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary text-white">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="card-title mb-0 fw-bold">
                                <i class="fas fa-cloud me-2"></i>Terraform Provisioned Architecture
                            </h5>
                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                                <i class="fas fa-check-circle me-1"></i>Terraform Managed
                            </span>
                        </div>
                        <p class="card-text opacity-90 mb-3">
                            This full-stack environment was declaratively provisioned and configured on AWS using HashiCorp Terraform. Supported deployment architectures: Single EC2, Decoupled Multi-Tier EC2, and Containerized ECS Fargate with ECR & ALB.
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-white text-dark py-2 px-3 rounded-3">
                                <strong>Provider:</strong> AWS hashicorp/aws v5.0+
                            </span>
                            <span class="badge bg-white text-dark py-2 px-3 rounded-3">
                                <strong>Target Backend:</strong> <%= backendUrl %>
                            </span>
                            <span class="badge bg-white text-dark py-2 px-3 rounded-3">
                                <strong>State:</strong> S3 / Local State Locking
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Submission Form Card -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0">
                        <h4 class="fw-bold text-dark mb-1">Developer Enrollment & Infrastructure Request</h4>
                        <p class="text-muted small">Submit your details below. The Express frontend forwards your transaction to the Flask backend API.</p>
                    </div>
                    
                    <div class="card-body p-4">
                        <% if (error) { %>
                            <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                                <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        <% } %>

                        <form action="/submit" method="POST" id="submissionForm">
                            <div class="mb-3">
                                <label for="name" class="form-label fw-semibold text-secondary">Full Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-user text-muted"></i></span>
                                    <input type="text" class="form-control border-start-0 ps-0" id="name" name="name" placeholder="e.g. Rahul Motvani" required value="Rahul Motvani">
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label for="email" class="form-label fw-semibold text-secondary">Email Address <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                                        <input type="email" class="form-control border-start-0 ps-0" id="email" name="email" placeholder="name@domain.com" required value="rahul.motvani@devops-cloud.io">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label for="course" class="form-label fw-semibold text-secondary">Track / Specialization</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-graduation-cap text-muted"></i></span>
                                        <select class="form-select border-start-0 ps-0" id="course" name="course">
                                            <option value="Terraform Infrastructure as Code" selected>Terraform Infrastructure as Code</option>
                                            <option value="AWS Cloud Architecture">AWS Cloud Architecture</option>
                                            <option value="Kubernetes Orchestration">Kubernetes Orchestration</option>
                                            <option value="CI/CD GitOps Automation">CI/CD GitOps Automation</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="priority" class="form-label fw-semibold text-secondary">Deployment Priority</label>
                                <div class="d-flex gap-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="priority" id="priorityLow" value="Low">
                                        <label class="form-check-label" for="priorityLow">Low</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="priority" id="priorityMed" value="Medium">
                                        <label class="form-check-label" for="priorityMed">Medium</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="priority" id="priorityHigh" value="High" checked>
                                        <label class="form-check-label" for="priorityHigh">High (Production)</label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="message" class="form-label fw-semibold text-secondary">Deployment Description</label>
                                <textarea class="form-control" id="message" name="message" rows="3" placeholder="Provide notes regarding infrastructure provisioning...">Infrastructure provisioned via Terraform: EC2 instances, VPC, Subnets, Security Groups, and ECS Fargate with ALB.</textarea>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold py-3 shadow-sm" id="submitBtn">
                                    <i class="fas fa-paper-plane me-2"></i>Submit via Express &rarr; Process via Flask
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Footer -->
                <div class="text-center mt-4 text-muted small">
                    <p class="mb-0">DevOps Assignment 8: Terraform &bull; Author: <strong>Rahul Motvani</strong></p>
                    <p class="text-secondary opacity-75">Provisioned with HashiCorp Terraform and Amazon Web Services</p>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
